<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    This project needs only nuget.org.

    Without <clear/>, NuGet inherits every source from the machine and user
    level config. On this developer machine that includes a private Azure
    DevOps feed, which answers 401 to anyone without credentials - including
    GitHub Actions. Restore then fails on CI with NU1301 even though the build
    works locally off the package cache.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
